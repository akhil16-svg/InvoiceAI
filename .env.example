# PostgreSQL connection (matches docker-compose.yml)
DATABASE_URL=postgresql://admin:secretpassword@localhost:5432/invoice_db

# Google AI (Gemini) API key - enables Gemini-powered invoice extraction and the
# "Ask AI" RAG assistant. Get a FREE key at https://aistudio.google.com/app/apikey
# The app still works without it (regex parser + retrieval-only search).
GOOGLE_API_KEY=

# Optional: override the Gemini model used (default: gemini-2.5-flash)
# INVOICEAI_MODEL=gemini-2.5-flash
